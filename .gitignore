# Виртуальное окружение
venv/
env/
.env

# Кэш Python
__pycache__/
*.pyc
*.pyo
*.pyd

# База данных
db.sqlite3
*.sqlite3

# Статика и медиа (собранные файлы)
staticfiles/
media/

# Файлы с секретами
.env
.secret

# Логи
*.log

# Настройки IDE
.vscode/
.idea/

# Файлы Windows
Thumbs.db
desktop.ini

# Файлы macOS
.DS_Store

# Тестовые данные и скрипты
fixtures/*.json
test_*.py
reset_*.py
create_*.py
load_*.py
RUN_*.bat
RUN_*.sh

# Временные файлы
*.tmp
*.bak
*.backup

# Миграции (опционально - лучше хранить в репозитории)
# */migrations/*.py
# !*/migrations/__init__.py